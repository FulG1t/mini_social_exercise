{% extends "base.html.j2" %}
{% block content %}

<div class="container mt-5 col-lg-8 mx-auto">
  <h2 class="text-center border-bottom pb-2 mb-4"><span>Groups</span></h2>

  {% if session.user_id %}
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title">Create a new group</h5>
      <form action="{{ url_for('create_group') }}" method="POST">
        <div class="mb-2">
          <input type="text" name="name" class="form-control" maxlength="{{ name_max }}"
               required>
        </div>
        <div class="mb-2">
          <textarea name="description" class="form-control" rows="2" maxlength="{{ description_max }}"
                 ></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Create and join</button>
      </form>
    </div>
  </div>
  {% else %}
  <p class="text-center"><a href="{{ url_for('login') }}">Log in</a> to join or create groups.</p>
  {% endif %}

  {% for g in groups %}
  <div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <h5 class="card-title mb-1">
          <a href="{{ url_for('group_detail', group_id=g.id) }}" class="text-decoration-none">{{ g.name }}</a>
          {% if g.id in my_group_ids %}<span class="badge bg-success ms-1">Member</span>{% endif %}
        </h5>
        <p class="card-text mb-1">{{ g.description or "No description." }}</p>
        <small class="text-muted">{{ g.member_count }} member{{ '' if g.member_count == 1 else 's' }}</small>
      </div>
      {% if session.user_id %}
        {% if g.id in my_group_ids %}
          <form action="{{ url_for('leave_group', group_id=g.id) }}" method="POST">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Leave</button>
          </form>
        {% else %}
          <form action="{{ url_for('join_group', group_id=g.id) }}" method="POST">
            <button type="submit" class="btn btn-primary btn-sm">Join</button>
          </form>
        {% endif %}
      {% endif %}
    </div>
  </div>
  {% else %}
  <p class="text-center text-muted">No groups yet. Be the first to create one!</p>
  {% endfor %}
</div>

{% endblock %}